#!/usr/bin/env bash
# Wrapper privato: usa lo stesso keyring del server MCP google-workspace.
set -euo pipefail
SECRETS="$HOME/.openclaw/secretary/secrets.env"
if [ -f "$SECRETS" ]; then
  set -a
  # shellcheck disable=SC1090
  . "$SECRETS"
  set +a
fi
export GOG_KEYRING_BACKEND="${GOG_KEYRING_BACKEND:-file}"
exec "$HOME/.local/bin/gog" "$@"
