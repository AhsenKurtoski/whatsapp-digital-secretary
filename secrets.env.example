# Private keys for the local gateway and dashboard.
# Install with: install -m 600 secrets.env.example ~/.openclaw/secretary/secrets.env
# Then fill in the values and restart the gateway.

# Groq primary (free tier): https://console.groq.com/keys
GROQ_API_KEY=

# Additional Groq keys from separate accounts add real quota.
# Keys from the same account share the same limit.
GROQ_API_KEY_2=

# Gemini pool (comma-separated) or a single key.
# Create keys at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_API_KEYS=

# Optional keyring password used by the gog Google CLI fallback.
GOG_KEYRING_BACKEND=file
GOG_KEYRING_PASSWORD=
