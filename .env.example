# Copy this file to .env for Docker/Compose, or set the same variables in
# ~/.openclaw/secretary/secrets.env for a systemd install.
# Never commit real keys.

# --- Business profile (safe to edit) ---------------------------------------
BUSINESS_NAME=Nome Attività
OWNER_NAME=Titolare
BOT_NAME=Segreteria Digitale
OWNER_NUMBER=+390000000000
GOOGLE_ACCOUNT=you@example.com
BOT_LANGUAGE=italiano
BOT_TIMEZONE=Europe/Rome
SITE_URL=https://example.com
BUSINESS_CITY=Città
BUSINESS_HOURS=Lun–Ven 9:00–18:00
DASHBOARD_PORT=8787

# --- AI providers (private) ------------------------------------------------
# Groq: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_API_KEY_2=

# Gemini: https://aistudio.google.com/app/apikey
# GEMINI_API_KEYS accepts a comma-separated pool and is the recommended form.
GEMINI_API_KEY=
GEMINI_API_KEYS=

# --- Optional Google keyring (gog fallback) --------------------------------
GOG_KEYRING_BACKEND=file
GOG_KEYRING_PASSWORD=
