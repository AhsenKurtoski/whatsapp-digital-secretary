[Unit]
Description=OpenClaw Secretary Dashboard (private localhost)
After=network-online.target openclaw-gateway.service
Wants=openclaw-gateway.service

[Service]
Type=simple
WorkingDirectory=%h/.openclaw/secretary
ExecStart=/usr/bin/python3 %h/.openclaw/secretary/dashboard.py
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1
NoNewPrivileges=yes
PrivateTmp=yes
# Misurata a ~32 MB. Il limite è largo perché il cgroup include anche i figli
# che la dashboard lancia (es. `openclaw message send`, Node): 512 MB restano
# un tetto reale per una macchina da 2 GB senza rischiare un OOM kill.
MemoryHigh=384M
MemoryMax=512M

[Install]
WantedBy=default.target
