[Unit]
Description=OpenClaw Secretary Health Scan and Token Alerts
After=network-online.target openclaw-gateway.service

[Service]
Type=oneshot
WorkingDirectory=%h/.openclaw/secretary
ExecStart=/usr/bin/python3 %h/.openclaw/secretary/healthcheck.py --notify
Nice=10
NoNewPrivileges=yes
PrivateTmp=yes
TimeoutStartSec=180
