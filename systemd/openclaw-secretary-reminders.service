[Unit]
Description=OpenClaw Secretary WhatsApp Reminders
After=network-online.target openclaw-gateway.service

[Service]
Type=oneshot
WorkingDirectory=%h/.openclaw/secretary
ExecStart=/usr/bin/python3 %h/.openclaw/secretary/reminders.py
Nice=10
NoNewPrivileges=yes
PrivateTmp=yes
TimeoutStartSec=180
